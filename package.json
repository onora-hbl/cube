{
  "name": "cube",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "pnpm -r clean",
    "build:cube-types": "pnpm --filter cube-types build",
    "dev:cube-types": "pnpm --filter cube-types dev",
    "build:cube-api-server": "pnpm --filter cube-api-server... build",
    "run:cube-api-server": "pnpm --filter cube-api-server start",
    "dev:cube-api-server": "pnpm --filter cube-api-server dev",
    "build:cubelet": "pnpm --filter cubelet... build",
    "run:cubelet": "pnpm --filter cubelet start",
    "dev:cubelet": "pnpm --filter cubelet dev",
    "build:cube-cli": "pnpm --filter cube-cli... build",
    "run:cube-cli": "pnpm --filter cube-cli start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
