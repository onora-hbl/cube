{
  "name": "cube-api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && pnpm copy:migrations",
    "copy:migrations": "node -e \"require('node:fs').cpSync('src/migrations', 'dist/migrations', { recursive: true })\"",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "LOG_LEVEL=debug tsx watch --clear-screen=false src/index.ts",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "cube-types": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pino": "^7.0.5"
  }
}
